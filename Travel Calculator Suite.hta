<html>
<head>
<title>Travel Calculator Suite</title>
<HTA:APPLICATION
  APPLICATIONNAME="Travel Calculator Suite"
  BORDER="thick"
  CAPTION="yes"
  SHOWINTASKBAR="yes"
  SINGLEINSTANCE="yes"
  WINDOWSTATE="normal"
  RESIZE="yes"
  SCROLL="yes"
  MINIMIZEBUTTON="yes"
  MAXIMIZEBUTTON="yes"
/>
<meta http-equiv="X-UA-Compatible" content="IE=9" />

<style>
html, body {
  margin: 0;
  padding: 0;
  height: 100%;
}
body {
  font-family: Arial, sans-serif;
  font-size: 16px;
  background: #f3f4f6;
  color: #111827;
  overflow: auto;
}
body.dark {
  background: #111827;
  color: #f3f4f6;
}
.app {
  box-sizing: border-box;
  padding: 1em;
  width: 100%;
}
.header {
  margin-bottom: 1em;
}
h1 {
  margin: 0;
  font-size: 1.6em;
}
.tabs {
  margin: 1em 0;
}
.tabBtn {
  padding: 0.7em 1em;
  font-size: 0.95em;
  border: 1px solid #9aa3af;
  border-radius: 0.35em;
  background: #e5e7eb;
  color: #111827;
  cursor: pointer;
  margin-right: 0.5em;
  margin-bottom: 0.5em;
}
.tabBtn.active {
  background: #2563eb;
  color: #ffffff;
  border-color: #2563eb;
}
body.dark .tabBtn {
  background: #374151;
  color: #f3f4f6;
  border-color: #4b5563;
}
body.dark .tabBtn.active {
  background: #2563eb;
  color: #ffffff;
  border-color: #2563eb;
}
.tabPane {
  display: none;
}
.tabPane.active {
  display: block;
}
.layout {
  width: 100%;
  font-size: 0;
}
.col {
  display: inline-block;
  vertical-align: top;
  width: 49%;
  box-sizing: border-box;
  font-size: 1rem;
}
.colRight {
  margin-left: 2%;
}
.panel {
  box-sizing: border-box;
  border: 1px solid #cfd4dc;
  border-radius: 0.5em;
  background: #ffffff;
  padding: 1em;
  margin-bottom: 1em;
  overflow-wrap: break-word;
  word-wrap: break-word;
}
body.dark .panel {
  background: #1f2937;
  border-color: #374151;
}
.panel h2 {
  margin: 0 0 0.75em 0;
  font-size: 1.15em;
}
.field {
  margin-bottom: 0.9em;
}
label {
  display: block;
  font-weight: bold;
  margin-bottom: 0.35em;
  font-size: 0.95em;
}
input, select {
  width: 100%;
  box-sizing: border-box;
  padding: 0.6em;
  border: 1px solid #b8bec7;
  border-radius: 0.3em;
  font-size: 1em;
  background: #ffffff;
  color: #111827;
}
body.dark input, body.dark select {
  background: #111827;
  color: #f3f4f6;
  border-color: #4b5563;
}
button {
  padding: 0.65em 1em;
  font-size: 0.95em;
  border: 1px solid #9aa3af;
  border-radius: 0.35em;
  background: #e5e7eb;
  color: #111827;
  cursor: pointer;
  margin-right: 0.5em;
  margin-bottom: 0.5em;
}
body.dark button {
  background: #374151;
  color: #f3f4f6;
  border-color: #4b5563;
}
button.primary {
  background: #2563eb;
  color: #ffffff;
  border-color: #2563eb;
}
.themeRow {
  margin-bottom: 1em;
  text-align: right;
  font-size: 14px;
}
.note {
  margin-top: 0.8em;
  color: #555;
  font-size: 0.88em;
  line-height: 1.4;
}
body.dark .note {
  color: #d1d5db;
}
.error {
  color: #b00020;
  font-weight: bold;
  margin-top: 0.8em;
  line-height: 1.4;
}
body.dark .error {
  color: #fda4af;
}
.summaryRow {
  margin-bottom: 0.55em;
  line-height: 1.45;
  font-size: 0.96em;
}
.lineItem {
  padding: 0.7em 0.8em;
  margin-bottom: 0.45em;
  border: 1px solid #e5e7eb;
  border-radius: 0.35em;
  background: #fafafa;
  line-height: 1.45;
  font-size: 0.96em;
}
body.dark .lineItem {
  background: #111827;
  border-color: #374151;
}
.adjustedNote {
  color: #555;
  font-size: 0.9em;
}
body.dark .adjustedNote {
  color: #d1d5db;
}
.packageEntry {
  padding: 0.8em;
  margin-bottom: 0.7em;
  border: 1px solid #e5e7eb;
  border-radius: 0.35em;
  background: #fafafa;
}
body.dark .packageEntry {
  background: #111827;
  border-color: #374151;
}
.packageEntryTitle {
  font-weight: bold;
  margin-bottom: 0.65em;
}
.packageCheckRow {
  margin-top: 0.55em;
  font-size: 0.92em;
}
.packageCheckRow input {
  width: auto;
  margin-right: 0.4em;
}
.instructionsBox {
  white-space: pre-line;
  line-height: 1.45;
  font-size: 0.94em;
}

/* Responsive layout for narrow HTA windows and monitor scaling. */
@media screen and (max-width: 760px) {
  .app { padding: 0.75em; }
  .col {
    display: block;
    width: 100% !important;
  }
  .colRight {
    margin-left: 0 !important;
  }
  .tabs { margin: 0.75em 0; }
  .tabBtn, button {
    max-width: 100%;
    white-space: normal;
  }
}

@media screen and (min-width: 761px) {
  .layout { display: block; }
  .col { display: inline-block; }
}
</style>

<script type="text/javascript">
function byId(id) { return document.getElementById(id); }

/* Upper bounds on user-supplied counts that drive loops and array allocation.
   Without these, a pasted or fat-fingered count hangs or crashes the app:
   999999999 payments exhausts memory, and a non-finite count loops forever.
   MAX_PAYMENTS is 120 (10 years of monthly payments), far beyond any real
   travel package. MAX_PACKAGES keeps the pre-existing 50-package ceiling. */
var MAX_PAYMENTS = 120;
var MAX_PACKAGES = 50;

/* isNaN() alone does not reject Infinity, so every numeric field is checked
   with this before it reaches arithmetic, a loop, or an array allocation. */
function isFiniteNumber(value) {
  return typeof value === "number" && isFinite(value);
}
function roundToDollar(value) { return Math.round(value); }
function roundMoney(value) { return Math.round(value * 100) / 100; }
function formatMoney(value) { return "$" + roundMoney(value).toFixed(2); }

/* Accept common currency entry styles without losing the decimal point.
   Examples: 4923.00, 4,923.00, $4,923.00 */
function parseMoney(value) {
  var text = String(value == null ? "" : value);
  text = text.replace(/\s/g, "");
  text = text.replace(/\$/g, "");
  text = text.replace(/,/g, "");
  if (text === "" || !/^-?\d*(\.\d{0,2})?$/.test(text) || text === "." || text === "-" || text === "-.") return NaN;
  return parseFloat(text);
}

/* Percentages are not money: no currency symbol, no thousands separator, and
   more than two decimals is legitimate (33.333%). But parseFloat("150abc")
   returns 150, which is the same silent-garbage problem parseMoney fixes for
   dollar fields. So percentages get their own strict parser: optional sign,
   digits, unlimited decimals, nothing else. */
function parsePercent(value) {
  var text = String(value == null ? "" : value);
  text = text.replace(/\s/g, "");
  if (text === "" || !/^-?\d*(\.\d*)?$/.test(text) || text === "." || text === "-" || text === "-.") return NaN;
  return parseFloat(text);
}
function formatSignedMoney(value) {
  var amount = roundMoney(value);
  if (amount > 0) return "+" + formatMoney(amount);
  if (amount < 0) return "-" + formatMoney(Math.abs(amount));
  return "$0.00";
}
function escapeHtml(value) {
  return String(value).replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;");
}
function moneyToCents(value) { return Math.round(value * 100); }
function centsToMoney(value) { return value / 100; }
function buildFinalAdjustedSchedule(balance, paymentCount) {
  var payments = [];
  /* Defensive bound: this is also called directly, so it must never be handed
     a non-finite or unbounded count that would loop or allocate without end. */
  if (!isFiniteNumber(balance)) balance = 0;
  if (!isFiniteNumber(paymentCount) || paymentCount < 0) paymentCount = 0;
  paymentCount = Math.min(Math.floor(paymentCount), MAX_PAYMENTS);
  var totalCents = moneyToCents(balance);
  var regularCents = paymentCount > 0 ? Math.round(totalCents / paymentCount) : 0;
  var usedCents = 0;
  var finalCents = 0;
  var i = 0;

  for (i = 0; i < paymentCount; i++) {
    var paymentCents = regularCents;
    if (i === paymentCount - 1) paymentCents = totalCents - usedCents;
    payments.push(centsToMoney(paymentCents));
    usedCents += paymentCents;
    finalCents = paymentCents;
  }

  return {
    payments: payments,
    regular: centsToMoney(regularCents),
    final: centsToMoney(finalCents),
    adjustment: centsToMoney(finalCents - regularCents),
    total: centsToMoney(totalCents)
  };
}

function getParticipantWidth() {
  if (document.documentElement && document.documentElement.participantWidth) return document.documentElement.participantWidth;
  if (document.body && document.body.participantWidth) return document.body.participantWidth;
  if (document.documentElement && document.documentElement.clientWidth) return document.documentElement.clientWidth;
  if (document.body && document.body.clientWidth) return document.body.clientWidth;
  return 900;
}
function getParticipantHeight() {
  if (document.documentElement && document.documentElement.participantHeight) return document.documentElement.participantHeight;
  if (document.body && document.body.participantHeight) return document.body.participantHeight;
  if (document.documentElement && document.documentElement.clientHeight) return document.documentElement.clientHeight;
  if (document.body && document.body.clientHeight) return document.body.clientHeight;
  return 700;
}
function getBaseFontPx() {
  var size = 16;
  if (document.body && document.body.currentStyle && document.body.currentStyle.fontSize) {
    var raw = document.body.currentStyle.fontSize;
    if (raw.indexOf("px") > -1) size = parseFloat(raw);
  }
  return size;
}

function showTab(tabName) {
  byId("paymentsTab").className = "tabPane" + (tabName === "payments" ? " active" : "");
  byId("refundTab").className = "tabPane" + (tabName === "refund" ? " active" : "");
  byId("partialRefundTab").className = "tabPane" + (tabName === "partialRefund" ? " active" : "");
  byId("paymentsTabBtn").className = "tabBtn" + (tabName === "payments" ? " active" : "");
  byId("refundTabBtn").className = "tabBtn" + (tabName === "refund" ? " active" : "");
  byId("partialRefundTabBtn").className = "tabBtn" + (tabName === "partialRefund" ? " active" : "");
  setPanelHeights();
}

function setTheme() {
  document.body.className = byId("darkMode").checked ? "dark" : "";
  setPanelHeights();
}

function setPanelHeights() {
  var width = getParticipantWidth();
  var height = getParticipantHeight();
  var responsiveFontPx = Math.max(13, Math.min(18, Math.round(width / 60)));
  document.body.style.fontSize = responsiveFontPx + "px";
  var fontPx = getBaseFontPx();

  var groups = [
    { left: "leftCol1", right: "rightCol1", summary: "summaryPanel1", results: "resultsPanel1", box: "resultsBox1" },
    { left: "leftCol2", right: "rightCol2", summary: "summaryPanel2", results: "resultsPanel2", box: "resultsBox2" },
    { left: "leftCol3", right: "rightCol3", summary: "summaryPanel3", results: "resultsPanel3", box: "resultsBox3" }
  ];

  for (var g = 0; g < groups.length; g++) {
    var leftCol = byId(groups[g].left);
    var rightCol = byId(groups[g].right);
    var summaryPanel = byId(groups[g].summary);
    var resultsPanel = byId(groups[g].results);
    var resultsBox = byId(groups[g].box);
    if (!leftCol) continue;

    if (width <= 760) {
      leftCol.style.width = "100%";
      rightCol.style.width = "100%";
      rightCol.style.marginLeft = "0";
      summaryPanel.style.minHeight = (fontPx * 8) + "px";
      resultsPanel.style.minHeight = (fontPx * 10) + "px";
      resultsBox.style.maxHeight = "";
      resultsBox.style.overflowY = "visible";
    } else {
      leftCol.style.width = "49%";
      rightCol.style.width = "49%";
      rightCol.style.marginLeft = "2%";
      summaryPanel.style.minHeight = Math.max(fontPx * 11, height * 0.24) + "px";
      resultsPanel.style.minHeight = Math.max(fontPx * 16, height * 0.42) + "px";
      resultsBox.style.maxHeight = Math.max(fontPx * 18, height * 0.46) + "px";
      resultsBox.style.overflowY = "auto";
    }
  }
}

function getDepositAmount(packagePrice) {
  var depositType = byId("depositType").value;
  var depositPercent = parsePercent(byId("depositPercent").value);
  var depositAmountInput = parseMoney(byId("depositAmount").value);

  /* Upper bound on the deposit. Every other check here is a LOWER bound, so
     nothing stopped a deposit above the package price from producing a
     negative balance and negative scheduled payments.

     The limit depends on how Payment 1 is treated, because the schedule
     subtracts the deposit TWICE when Payment 1 mirrors it (see the
     `firstMatches` branch in calculatePayments: price - deposit - deposit).
     Bounding the deposit alone is therefore NOT sufficient on that path.
       Payment 1 matches deposit = No  ->  deposit may be up to the full price
       Payment 1 matches deposit = Yes ->  deposit may be up to half the price
     Equal to the limit is allowed: paying in full up front is legitimate and
     leaves a zero balance, not a negative one. */
  var firstMatchesDeposit = byId("firstMatchesDeposit").value === "yes";
  var maxDeposit = firstMatchesDeposit ? packagePrice / 2 : packagePrice;

  if (depositType === "percent") {
    if (isNaN(depositPercent)) return { ok: false, message: "Please enter a valid deposit percentage." };
    if (!isFiniteNumber(depositPercent)) return { ok: false, message: "Please enter a valid deposit percentage." };
    if (depositPercent < 0) return { ok: false, message: "Deposit percentage cannot be negative." };
    /* Bound the COMPUTED amount, not the raw percentage, so one rule covers
       both 150% and a percentage that only overshoots on the Payment 1 path. */
    var percentAmount = roundToDollar(packagePrice * (depositPercent / 100));
    if (percentAmount > maxDeposit) {
      return {
        ok: false,
        message: firstMatchesDeposit
          ? "Deposit works out to more than half the package price, which it cannot be when Payment 1 matches the deposit. Lower the percentage, or set Payment 1 matches deposit to No."
          : "Deposit works out to more than the package price. Check the percentage for an extra digit."
      };
    }
    return {
      ok: true,
      amount: percentAmount,
      label: "Deposit percentage",
      valueText: depositPercent + "%"
    };
  }

  if (isNaN(depositAmountInput)) return { ok: false, message: "Please enter a valid deposit dollar amount." };
  if (!isFiniteNumber(depositAmountInput)) return { ok: false, message: "Please enter a valid deposit dollar amount." };
  if (depositAmountInput < 0) return { ok: false, message: "Deposit amount cannot be negative." };

  var amountDeposit = roundToDollar(depositAmountInput);
  if (amountDeposit > maxDeposit) {
    return {
      ok: false,
      message: firstMatchesDeposit
        ? "Deposit cannot be more than half the package price when Payment 1 matches the deposit. Lower the deposit, or set Payment 1 matches deposit to No."
        : "Deposit cannot be more than the package price. Check for an extra zero, or switch to a deposit percentage."
    };
  }

  return {
    ok: true,
    amount: amountDeposit,
    label: "Deposit amount",
    valueText: formatMoney(amountDeposit) + " (rounded to nearest dollar)"
  };
}

function updateDepositInputs() {
  var depositType = byId("depositType").value;
  byId("depositPercentWrap").style.display = depositType === "percent" ? "block" : "none";
  byId("depositAmountWrap").style.display = depositType === "amount" ? "block" : "none";
  calculatePayments();
}

function calculatePayments() {
  var packagePrice = parseMoney(byId("packagePrice").value);
  var totalPayments = parseInt(byId("totalPayments").value, 10);
  var firstMatches = byId("firstMatchesDeposit").value === "yes";

  byId("errorBox1").innerHTML = "";
  byId("summaryBox1").innerHTML = "";
  byId("resultsBox1").innerHTML = "";

  if (isNaN(packagePrice) || isNaN(totalPayments)) {
    byId("errorBox1").innerHTML = "Please enter valid numbers.";
    setPanelHeights();
    return;
  }
  /* isNaN misses Infinity, which would reach the arithmetic and render
     "$Infinity"/"$NaN" amounts. Reject non-finite values explicitly. */
  if (!isFiniteNumber(packagePrice) || !isFiniteNumber(totalPayments)) {
    byId("errorBox1").innerHTML = "Please enter valid numbers.";
    setPanelHeights();
    return;
  }
  if (packagePrice < 0) {
    byId("errorBox1").innerHTML = "Package price cannot be negative.";
    setPanelHeights();
    return;
  }
  if (totalPayments < 1) {
    byId("errorBox1").innerHTML = "Number of payments must be at least 1.";
    setPanelHeights();
    return;
  }
  /* Silently clamp an over-large count, matching how the Partial Package
     Refunds tab already clamps the package count to 50. */
  if (totalPayments > MAX_PAYMENTS) {
    byId("totalPayments").value = String(MAX_PAYMENTS);
    totalPayments = MAX_PAYMENTS;
  }

  var depositInfo = getDepositAmount(packagePrice);
  if (!depositInfo.ok) {
    byId("errorBox1").innerHTML = depositInfo.message;
    setPanelHeights();
    return;
  }

  var deposit = depositInfo.amount;
  var summaryHtml = "";
  var resultsHtml = "";
  var remainder = 0;
  var eachPayment = 0;
  var remainingCount = 0;
  var i = 0;
  var schedule = null;
  var finalNote = "";

  resultsHtml += '<div class="lineItem"><strong>Deposit:</strong> ' + formatMoney(deposit) + '</div>';

  if (firstMatches) {
    var firstPayment = deposit;
    resultsHtml += '<div class="lineItem"><strong>Payment 1:</strong> ' + formatMoney(firstPayment) + '</div>';

    remainder = roundMoney(packagePrice - deposit - firstPayment);
    remainingCount = totalPayments - 1;
    schedule = buildFinalAdjustedSchedule(remainder, remainingCount);
    eachPayment = schedule.regular;

    for (i = 0; i < remainingCount; i++) {
      finalNote = (i === remainingCount - 1 && schedule.adjustment !== 0) ? ' <span class="adjustedNote">(final adjusted)</span>' : '';
      resultsHtml += '<div class="lineItem"><strong>Payment ' + (i + 2) + ':</strong> ' + formatMoney(schedule.payments[i]) + finalNote + '</div>';
    }

    summaryHtml += '<div class="summaryRow"><strong>' + depositInfo.label + ':</strong> ' + depositInfo.valueText + '</div>';
    summaryHtml += '<div class="summaryRow"><strong>Deposit used:</strong> ' + formatMoney(deposit) + '</div>';
    summaryHtml += '<div class="summaryRow"><strong>Payment 1 matches deposit:</strong> Yes</div>';
    summaryHtml += '<div class="summaryRow"><strong>Remaining balance after deposit and Payment 1:</strong> ' + formatMoney(remainder) + '</div>';
    summaryHtml += '<div class="summaryRow"><strong>Remaining payments after Payment 1:</strong> ' + remainingCount + '</div>';
    summaryHtml += '<div class="summaryRow"><strong>Regular remaining payment:</strong> ' + formatMoney(eachPayment) + '</div>';
    if (remainingCount > 0 && schedule.adjustment !== 0) {
      summaryHtml += '<div class="summaryRow"><strong>Final payment adjustment:</strong> ' + formatSignedMoney(schedule.adjustment) + '</div>';
      summaryHtml += '<div class="summaryRow"><strong>Final remaining payment:</strong> ' + formatMoney(schedule.final) + '</div>';
    }
  } else {
    remainder = roundMoney(packagePrice - deposit);
    schedule = buildFinalAdjustedSchedule(remainder, totalPayments);
    eachPayment = schedule.regular;

    for (i = 0; i < totalPayments; i++) {
      finalNote = (i === totalPayments - 1 && schedule.adjustment !== 0) ? ' <span class="adjustedNote">(final adjusted)</span>' : '';
      resultsHtml += '<div class="lineItem"><strong>Payment ' + (i + 1) + ':</strong> ' + formatMoney(schedule.payments[i]) + finalNote + '</div>';
    }

    summaryHtml += '<div class="summaryRow"><strong>' + depositInfo.label + ':</strong> ' + depositInfo.valueText + '</div>';
    summaryHtml += '<div class="summaryRow"><strong>Deposit used:</strong> ' + formatMoney(deposit) + '</div>';
    summaryHtml += '<div class="summaryRow"><strong>Payment 1 matches deposit:</strong> No</div>';
    summaryHtml += '<div class="summaryRow"><strong>Remaining balance after deposit:</strong> ' + formatMoney(remainder) + '</div>';
    summaryHtml += '<div class="summaryRow"><strong>Number of even payments:</strong> ' + totalPayments + '</div>';
    summaryHtml += '<div class="summaryRow"><strong>Regular payment:</strong> ' + formatMoney(eachPayment) + '</div>';
    if (schedule.adjustment !== 0) {
      summaryHtml += '<div class="summaryRow"><strong>Final payment adjustment:</strong> ' + formatSignedMoney(schedule.adjustment) + '</div>';
      summaryHtml += '<div class="summaryRow"><strong>Final payment:</strong> ' + formatMoney(schedule.final) + '</div>';
    }
  }

  byId("summaryBox1").innerHTML = summaryHtml;
  byId("resultsBox1").innerHTML = resultsHtml;
  setPanelHeights();
}

function resetPayments() {
  byId("packagePrice").value = "2500";
  byId("depositType").value = "percent";
  byId("depositPercent").value = "20";
  byId("depositAmount").value = "500";
  byId("totalPayments").value = "6";
  byId("firstMatchesDeposit").value = "yes";
  updateDepositInputs();
}

function calculateRefund() {
  var totalCost = parseMoney(byId("refundTotalCost").value);
  var amountPaid = parseMoney(byId("refundAmountPaid").value);
  var tpp = parseMoney(byId("refundTpp").value);

  byId("errorBox2").innerHTML = "";
  byId("summaryBox2").innerHTML = "";
  byId("resultsBox2").innerHTML = "";

  if (isNaN(totalCost) || isNaN(amountPaid) || isNaN(tpp)) {
    byId("errorBox2").innerHTML = "Please enter valid non-negative numbers.";
    setPanelHeights();
    return;
  }
  /* Reject Infinity, which isNaN allows through into the refund arithmetic. */
  if (!isFiniteNumber(totalCost) || !isFiniteNumber(amountPaid) || !isFiniteNumber(tpp)) {
    byId("errorBox2").innerHTML = "Please enter valid non-negative numbers.";
    setPanelHeights();
    return;
  }
  if (totalCost < 0 || amountPaid < 0 || tpp < 0) {
    byId("errorBox2").innerHTML = "Negative values are not allowed.";
    setPanelHeights();
    return;
  }

  var twentyPercent = roundMoney(totalCost * 0.20);
  var nonRefundable = roundMoney(tpp + twentyPercent);
  var refund = roundMoney(Math.max(amountPaid - nonRefundable, 0));
  var now = new Date();
  var stamp = now.getFullYear() + "-" +
    ("0" + (now.getMonth() + 1)).slice(-2) + "-" +
    ("0" + now.getDate()).slice(-2) + " " +
    ("0" + now.getHours()).slice(-2) + ":" +
    ("0" + now.getMinutes()).slice(-2) + ":" +
    ("0" + now.getSeconds()).slice(-2);

  var summaryHtml = "";
  summaryHtml += '<div class="summaryRow"><strong>Calculation time:</strong> ' + stamp + '</div>';
  summaryHtml += '<div class="summaryRow"><strong>Total Package Cost:</strong> ' + formatMoney(totalCost) + '</div>';
  summaryHtml += '<div class="summaryRow"><strong>Amount Paid:</strong> ' + formatMoney(amountPaid) + '</div>';
  summaryHtml += '<div class="summaryRow"><strong>TPP:</strong> ' + formatMoney(tpp) + '</div>';
  summaryHtml += '<div class="summaryRow"><strong>20% of Package Cost:</strong> ' + formatMoney(twentyPercent) + '</div>';
  summaryHtml += '<div class="summaryRow"><strong>Non-Refundable (TPP + 20%):</strong> ' + formatMoney(nonRefundable) + '</div>';

  var resultHtml = "";
  resultHtml += '<div class="lineItem"><strong>Refund Due:</strong> ' + formatMoney(refund) + '</div>';
  if (refund === 0) {
    resultHtml += '<div class="lineItem">No refund is due.</div>';
  }
  resultHtml += '<div class="lineItem"><strong>Formula used:</strong> Amount Paid - (TPP + 20% of Package Cost)</div>';

  byId("summaryBox2").innerHTML = summaryHtml;
  byId("resultsBox2").innerHTML = resultHtml;
  setPanelHeights();
}

function resetRefund() {
  byId("refundTotalCost").value = "";
  byId("refundAmountPaid").value = "";
  byId("refundTpp").value = "";
  byId("summaryBox2").innerHTML = "";
  byId("resultsBox2").innerHTML = "";
  byId("errorBox2").innerHTML = "";
  setPanelHeights();
}

function updatePartialPackageInputs() {
  var count = parseInt(byId("partialPackageCount").value, 10);
  var wrap = byId("partialPackageInputs");
  var html = "";
  var i = 0;

  if (isNaN(count) || count < 1 || !isFiniteNumber(count)) {
    wrap.innerHTML = "";
    byId("errorBox3").innerHTML = "Number of packages must be at least 1.";
    byId("summaryBox3").innerHTML = "";
    byId("resultsBox3").innerHTML = "";
    setPanelHeights();
    return;
  }
  if (count > MAX_PACKAGES) {
    byId("partialPackageCount").value = String(MAX_PACKAGES);
    count = MAX_PACKAGES;
  }

  byId("errorBox3").innerHTML = "";
  for (i = 1; i <= count; i++) {
    html += '<div class="packageEntry">';
    html += '<div class="packageEntryTitle">Package ' + i + '</div>';
    html += '<div class="field"><label for="partialPackagePrice' + i + '">Package Price</label>';
    html += '<input id="partialPackagePrice' + i + '" type="text" value="" onkeyup="calculatePartialRefund()" /></div>';
    html += '<div class="packageCheckRow"><label style="display:inline; font-weight:normal;">';
    html += '<input id="partialPackageCancel' + i + '" type="checkbox" onclick="calculatePartialRefund()" /> Include this package in refund</label></div>';
    html += '</div>';
  }
  wrap.innerHTML = html;
  byId("summaryBox3").innerHTML = "";
  byId("resultsBox3").innerHTML = "";
  setPanelHeights();
}

function calculatePartialRefund() {
  var count = parseInt(byId("partialPackageCount").value, 10);
  var tppEach = parseMoney(byId("partialTpp").value);
  var nonRefundPercent = parsePercent(byId("partialNonRefundPercent").value);
  var amountPaid = parseMoney(byId("partialAmountPaid").value);
  var typedTotalPackagePrice = parseMoney(byId("partialTotalPackagePrice").value);
  var prices = [];
  var selected = [];
  var allocatedPaid = [];
  var totalPackagePrice = 0;
  var totalTpp = 0;
  var tripValue = 0;
  var totalSelectedRefund = 0;
  var selectedCount = 0;
  var summaryHtml = "";
  var resultHtml = "";
  var i = 0;

  byId("errorBox3").innerHTML = "";
  byId("summaryBox3").innerHTML = "";
  byId("resultsBox3").innerHTML = "";

  if (isNaN(count) || count < 1 || isNaN(tppEach) || isNaN(nonRefundPercent) || isNaN(amountPaid) || isNaN(typedTotalPackagePrice)) {
    byId("errorBox3").innerHTML = "Please complete the package count, TPP, non-refundable percentage, total package price, amount paid, and all package prices.";
    setPanelHeights();
    return;
  }
  /* isNaN misses Infinity; a non-finite count would also drive the allocation
     loop below without end. */
  if (!isFiniteNumber(count) || !isFiniteNumber(tppEach) || !isFiniteNumber(nonRefundPercent) || !isFiniteNumber(amountPaid) || !isFiniteNumber(typedTotalPackagePrice)) {
    byId("errorBox3").innerHTML = "Please complete the package count, TPP, non-refundable percentage, total package price, amount paid, and all package prices.";
    setPanelHeights();
    return;
  }
  /* The allocation loop below runs `count` times regardless of how many price
     rows exist, so the 50-package ceiling must be enforced HERE as well as in
     updatePartialPackageInputs. Without this, a pasted count of 50,000,000
     stalls the app for ~26 seconds even with two rows on screen. */
  if (count > MAX_PACKAGES) {
    byId("partialPackageCount").value = String(MAX_PACKAGES);
    count = MAX_PACKAGES;
  }
  if (tppEach < 0 || nonRefundPercent < 0 || amountPaid < 0 || typedTotalPackagePrice < 0) {
    byId("errorBox3").innerHTML = "Negative values are not allowed.";
    setPanelHeights();
    return;
  }
  if (nonRefundPercent > 100) {
    byId("errorBox3").innerHTML = "Non-refundable percentage cannot be greater than 100%.";
    setPanelHeights();
    return;
  }

  for (i = 1; i <= count; i++) {
    var priceInput = byId("partialPackagePrice" + i);
    var cancelInput = byId("partialPackageCancel" + i);
    if (!priceInput) continue;
    var price = parseMoney(priceInput.value);
    if (isNaN(price) || price < 0 || !isFiniteNumber(price)) {
      byId("errorBox3").innerHTML = "Please enter a valid price for Package " + i + " (for example 4923.00 or 4,923.00).";
      setPanelHeights();
      return;
    }
    prices.push(roundMoney(price));
    selected.push(cancelInput && cancelInput.checked);
    totalPackagePrice += price;
  }

  totalPackagePrice = roundMoney(totalPackagePrice);
  totalTpp = roundMoney(tppEach * count);
  tripValue = roundMoney(totalPackagePrice + totalTpp);

  /* The individual package price rows must add up to the typed Total Package
     Price. Compared in integer CENTS against `totalPackagePrice`, the same
     variable the allocation uses, so the check and the math can never
     disagree; a float comparison here would produce phantom mismatches
     (1000.10 + 2000.20 + 3000.30 is 6000.599999999999 as a float).
     The loop above skips absent rows, so a blank row short-changes the sum
     and lands here - hence the wording. */
  if (moneyToCents(totalPackagePrice) !== moneyToCents(typedTotalPackagePrice)) {
    byId("errorBox3").innerHTML = "Package prices add up to " + formatMoney(totalPackagePrice) +
      " but Total Package Price is " + formatMoney(typedTotalPackagePrice) +
      ". Check the individual package prices, including any left blank.";
    setPanelHeights();
    return;
  }

  if (amountPaid > tripValue) {
    byId("errorBox3").innerHTML = "Amount Paid cannot be greater than the total trip value (package prices + TPP).";
    setPanelHeights();
    return;
  }

  /* The receipt does not split Amount Paid by package. TPP is treated as paid first.
     Any amount above total TPP is allocated proportionally by package price.
     Each package is calculated independently from the same formula so two packages
     with the same price always receive the same estimated paid amount/refund. */
  var amountPaidCents = moneyToCents(amountPaid);
  var totalTppCents = moneyToCents(totalTpp);
  var packagePoolCents = Math.max(amountPaidCents - totalTppCents, 0);

  if (amountPaidCents < totalTppCents) {
    var partialTppPerPackage = roundMoney(amountPaid / count);
    for (i = 0; i < count; i++) {
      allocatedPaid.push(partialTppPerPackage);
    }
  } else {
    for (i = 0; i < count; i++) {
      var packageShare = 0;
      if (totalPackagePrice > 0) {
        packageShare = centsToMoney(packagePoolCents) * (prices[i] / totalPackagePrice);
      }
      allocatedPaid.push(roundMoney(tppEach + packageShare));
    }
  }

  summaryHtml += '<div class="summaryRow"><strong>Number of Packages:</strong> ' + count + '</div>';
  summaryHtml += '<div class="summaryRow"><strong>Total Package Price:</strong> ' + formatMoney(totalPackagePrice) + '</div>';
  summaryHtml += '<div class="summaryRow"><strong>TPP Per Package:</strong> ' + formatMoney(tppEach) + '</div>';
  summaryHtml += '<div class="summaryRow"><strong>Total TPP:</strong> ' + formatMoney(totalTpp) + '</div>';
  summaryHtml += '<div class="summaryRow"><strong>Amount Paid:</strong> ' + formatMoney(amountPaid) + '</div>';
  summaryHtml += '<div class="summaryRow"><strong>Non-Refundable Percentage:</strong> ' + nonRefundPercent + '% per package</div>';
  summaryHtml += '<div class="summaryRow"><strong>Payment Allocation:</strong> TPP first, then remaining paid amount proportionally by package price</div>';
  if (amountPaidCents >= totalTppCents) {
    summaryHtml += '<div class="summaryRow"><strong>Paid Amount Allocated to Package Prices:</strong> ' + formatMoney(centsToMoney(packagePoolCents)) + '</div>';
  }

  for (i = 0; i < prices.length; i++) {
    var percentNonRefund = roundMoney(prices[i] * (nonRefundPercent / 100));
    var nonRefundable = roundMoney(tppEach + percentNonRefund);
    var refund = roundMoney(Math.max(allocatedPaid[i] - nonRefundable, 0));

    if (selected[i]) {
      resultHtml += '<div class="lineItem">';
      resultHtml += '<strong>Package ' + (i + 1) + '</strong><br />';
      resultHtml += 'Package Price: ' + formatMoney(prices[i]) + '<br />';
      resultHtml += 'Estimated Paid Toward Package: ' + formatMoney(allocatedPaid[i]) + '<br />';
      resultHtml += 'TPP Non-Refundable: ' + formatMoney(tppEach) + '<br />';
      resultHtml += nonRefundPercent + '% Non-Refundable: ' + formatMoney(percentNonRefund) + '<br />';
      resultHtml += 'Total Non-Refundable: ' + formatMoney(nonRefundable) + '<br />';
      resultHtml += '<strong>Refund Due: ' + formatMoney(refund) + '</strong><br />';
      resultHtml += '<span class="adjustedNote">Math: ' + formatMoney(allocatedPaid[i]) + ' - (' + formatMoney(tppEach) + ' + ' + formatMoney(percentNonRefund) + ') = ' + formatMoney(refund) + '</span>';
      resultHtml += '</div>';
      totalSelectedRefund = roundMoney(totalSelectedRefund + refund);
      selectedCount++;
    }
  }

  if (selectedCount === 0) {
    resultHtml = '<div class="lineItem">Check the package you want to refund to see its result.</div>';
  } else if (selectedCount > 1) {
    resultHtml += '<div class="lineItem"><strong>Total Refund Due: ' + formatMoney(totalSelectedRefund) + '</strong></div>';
  }

  byId("summaryBox3").innerHTML = summaryHtml;
  byId("resultsBox3").innerHTML = resultHtml;
  setPanelHeights();
}

function resetPartialRefund() {
  byId("partialPackageCount").value = "5";
  byId("partialTpp").value = "481";
  byId("partialNonRefundPercent").value = "20";
  byId("partialTotalPackagePrice").value = "";
  byId("partialAmountPaid").value = "";
  byId("errorBox3").innerHTML = "";
  byId("summaryBox3").innerHTML = "";
  byId("resultsBox3").innerHTML = "";
  updatePartialPackageInputs();
}

function initApp() {
  setTheme();
  showTab("payments");
  updateDepositInputs();
  updatePartialPackageInputs();
  setPanelHeights();
}
window.onload = initApp;
window.onresize = function() { setPanelHeights(); };
</script>
</head>

<body>
  <div class="app">
    <div class="header">
      <div class="themeRow">
        <label style="display:inline; font-weight:normal;">
          <input id="darkMode" type="checkbox" onclick="setTheme()" style="width:auto; margin-right:6px;" />
          Dark mode
        </label>
      </div>
      <h1>Travel Calculator Suite</h1>
    </div>

    <div class="tabs">
      <button id="paymentsTabBtn" class="tabBtn active" onclick="showTab('payments')">Payment Calculator</button>
      <button id="refundTabBtn" class="tabBtn" onclick="showTab('refund')">Refund Calculator</button>
      <button id="partialRefundTabBtn" class="tabBtn" onclick="showTab('partialRefund')">Partial Package Refunds</button>
    </div>

    <div id="paymentsTab" class="tabPane active">
      <div class="layout">
        <div class="col" id="leftCol1">
          <div class="panel">
            <div class="field">
              <label for="packagePrice">Package Price</label>
              <input id="packagePrice" type="text" value="2500" onkeyup="calculatePayments()" />
            </div>
            <div class="field">
              <label for="depositType">Deposit Type</label>
              <select id="depositType" onchange="updateDepositInputs()">
                <option value="percent" selected="selected">Percentage</option>
                <option value="amount">Dollar Amount</option>
              </select>
            </div>
            <div class="field" id="depositPercentWrap">
              <label for="depositPercent">Custom Deposit Percentage</label>
              <input id="depositPercent" type="text" value="20" onkeyup="calculatePayments()" />
            </div>
            <div class="field" id="depositAmountWrap" style="display:none;">
              <label for="depositAmount">Custom Deposit Dollar Amount</label>
              <input id="depositAmount" type="text" value="500" onkeyup="calculatePayments()" />
            </div>
            <div class="field">
              <label for="totalPayments">Total Number of Payments</label>
              <input id="totalPayments" type="text" value="6" onkeyup="calculatePayments()" />
            </div>
            <div class="field">
              <label for="firstMatchesDeposit">Does Payment 1 Match the Deposit?</label>
              <select id="firstMatchesDeposit" onchange="calculatePayments()">
                <option value="yes" selected="selected">Yes</option>
                <option value="no">No</option>
              </select>
            </div>
            <button class="primary" onclick="calculatePayments()">Calculate</button>
            <button onclick="resetPayments()">Reset</button>
            <div class="error" id="errorBox1"></div>
            <div class="note">Use either a percentage-based deposit or a fixed dollar deposit.</div>
          </div>
        </div>
        <div class="col colRight" id="rightCol1">
          <div class="panel" id="summaryPanel1">
            <h2>Summary</h2>
            <div id="summaryBox1"></div>
          </div>
          <div class="panel" id="resultsPanel1">
            <h2>Payment Breakdown</h2>
            <div id="resultsBox1"></div>
          </div>
        </div>
      </div>
    </div>

    <div id="refundTab" class="tabPane">
      <div class="layout">
        <div class="col" id="leftCol2">
          <div class="panel">
            <div class="field">
              <label for="refundTotalCost">Total Package Cost</label>
              <input id="refundTotalCost" type="text" value="" onkeyup="calculateRefund()" />
            </div>
            <div class="field">
              <label for="refundAmountPaid">Amount Participant Paid</label>
              <input id="refundAmountPaid" type="text" value="" onkeyup="calculateRefund()" />
            </div>
            <div class="field">
              <label for="refundTpp">TPP Amount</label>
              <input id="refundTpp" type="text" value="" onkeyup="calculateRefund()" />
            </div>
            <button class="primary" onclick="calculateRefund()">Calculate</button>
            <button onclick="resetRefund()">Clear</button>
            <div class="error" id="errorBox2"></div>
            <div class="note">Non-refundable is calculated as TPP + 20% of Total Package Cost.</div>
          </div>

          <div class="panel">
            <h2>Instructions</h2>
            <div class="instructionsBox">
Step 1: Total Package Cost
- Enter the cost of occupancy packages only
- Do NOT include TPP in this total
- If there are multiple packages, add them together first

Step 2: Amount Paid
- Go to the Transaction Summary
- Locate the line labeled "Amount Paid"
- Enter that amount

Step 3: TPP Cost
- Enter the total cost of the Trip Protection Plan
- If there are multiple TPPs, add them together before entering

Step 4: Calculate
- Click the "Calculate" button
- The refund amount will appear at the bottom
            </div>
          </div>
        </div>

        <div class="col colRight" id="rightCol2">
          <div class="panel" id="summaryPanel2">
            <h2>Summary</h2>
            <div id="summaryBox2"></div>
          </div>
          <div class="panel" id="resultsPanel2">
            <h2>Refund Result</h2>
            <div id="resultsBox2"></div>
          </div>
        </div>
      </div>
    </div>

    <div id="partialRefundTab" class="tabPane">
      <div class="layout">
        <div class="col" id="leftCol3">
          <div class="panel">
            <div class="field">
              <label for="partialPackageCount">Number of Packages</label>
              <input id="partialPackageCount" type="text" value="5" onkeyup="updatePartialPackageInputs()" />
            </div>
            <div class="field">
              <label for="partialTpp">TPP Amount Per Package</label>
              <input id="partialTpp" type="text" value="481" onkeyup="calculatePartialRefund()" />
            </div>
            <div class="field">
              <label for="partialNonRefundPercent">Non-Refundable Percentage Per Package</label>
              <input id="partialNonRefundPercent" type="text" value="20" onkeyup="calculatePartialRefund()" />
            </div>
            <div class="field">
              <label for="partialTotalPackagePrice">Total Package Price</label>
              <input id="partialTotalPackagePrice" type="text" value="" onkeyup="calculatePartialRefund()" />
            </div>
            <div class="field">
              <label for="partialAmountPaid">Amount Paid</label>
              <input id="partialAmountPaid" type="text" value="" onkeyup="calculatePartialRefund()" />
            </div>
            <div id="partialPackageInputs"></div>
            <button class="primary" onclick="calculatePartialRefund()">Calculate</button>
            <button onclick="resetPartialRefund()">Clear</button>
            <div class="error" id="errorBox3"></div>
            <div class="note">The non-refundable percentage is calculated separately from each package's own price. TPP is non-refundable per package.</div>
          </div>

          <div class="panel">
            <h2>Instructions</h2>
            <div class="instructionsBox">
Step 1: Number of Packages
- Enter how many packages are on the booking
- A box will appear for each package

Step 2: TPP and Non-Refundable Percentage
- Enter the TPP amount for one package
- Enter the non-refundable percentage
- The percentage is applied separately to each package price

Step 3: Total Package Price and Amount Paid
- Total Package Price is what the trip costs in total, from the receipt
- Amount Paid is what the participant has actually handed over so far
- Amount Paid is often less than the Total Package Price; that is normal
- The individual package prices in Step 4 must add up to the Total Package Price
- If they do not match, the calculator shows both figures and stops, so check
  for a mistyped price or a package row left blank

Step 4: Package Prices
- Enter each package's price without TPP
- Check the package or packages being removed

Step 5: Calculate
- The calculator estimates how much of the total payment belongs to each package
- It subtracts that package's TPP and non-refundable percentage
- Only checked package results are shown
- If more than one package is checked, their refunds are added together at the bottom
            </div>
          </div>
        </div>

        <div class="col colRight" id="rightCol3">
          <div class="panel" id="summaryPanel3">
            <h2>Summary</h2>
            <div id="summaryBox3"></div>
          </div>
          <div class="panel" id="resultsPanel3">
            <h2>Partial Refund Results</h2>
            <div id="resultsBox3"></div>
          </div>
        </div>
      </div>
    </div>
  </div>
</body>
</html>
